{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Joinery",
  "version": "1.0.2",
  "identifier": "uz.nurafshon.joinery",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Joinery",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 520,
        "decorations": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Otabek",
    "copyright": "Copyright © 2026 Otabek",
    "category": "DeveloperTool",
    "shortDescription": "Visual database schema designer",
    "longDescription": "Design database schemas visually and export them as SQL for PostgreSQL, MySQL, MariaDB, SQLite and SQL Server.",
    "homepage": "https://github.com/otabekoff/joinery",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    }
  }
}
